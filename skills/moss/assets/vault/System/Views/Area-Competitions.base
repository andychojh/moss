{
  "filters": {
    "and": [
      "type == \"project\"",
      "domain == \"Competitions\""
    ]
  },
  "views": [
    {
      "type": "table",
      "name": "Competitions projects",
      "order": [
        "file.name"
      ],
      "sort": [
        {
          "property": "file.name",
          "direction": "ASC"
        }
      ]
    }
  ]
}
