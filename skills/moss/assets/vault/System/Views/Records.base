{
  "filters": "type == \"task-record\"",
  "views": [
    {
      "type": "table",
      "name": "Latest per task",
      "filters": "record_current == true",
      "order": [
        "file.name",
        "note.domain",
        "note.evidence_as_of"
      ]
    },
    {
      "type": "table",
      "name": "All revisions",
      "order": [
        "file.name",
        "note.project_key",
        "note.revision"
      ]
    }
  ]
}
